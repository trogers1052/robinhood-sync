# Robinhood Sync Service Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Robinhood Credentials (REQUIRED)
# ===========================================
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password

# TOTP Secret for 2FA (OPTIONAL)
# If you have 2FA enabled, provide the TOTP secret for automated login
# You can get this from your authenticator app setup
# ROBINHOOD_TOTP_SECRET=your_totp_secret

# Pinned device identity (STRONGLY RECOMMENDED in production)
# Robinhood challenges *new* devices. Keeping this stable is what stops a lost
# session from turning into a device approval a headless service cannot answer.
# Generated and persisted automatically if unset — `prime_session` prints the
# value to record here (or in /run/secrets/robinhood_device_token).
# ROBINHOOD_DEVICE_TOKEN=

# ===========================================
# Session persistence
# ===========================================
# The OAuth session (access + refresh token + device token) is persisted to
# Redis with a local file mirror, and the access token is refreshed at half its
# life. That keeps the service off the password-login path, which is the only
# path that can trigger a device challenge.
#
# To mint a session interactively (from a machine with a human present):
#   REDIS_HOST=<pi-host> python -m robinhood_sync.prime_session
SESSION_REDIS_ENABLED=true
REDIS_SESSION_KEY=robinhood:session
# Must be on a persistent volume in Docker (the .tokens dir is volume-backed).
ROBINHOOD_SESSION_FILE=~/.tokens/robinhood_session.json
# Access token lifetime to request, and when to refresh it.
SESSION_EXPIRES_IN=86400
SESSION_REFRESH_RATIO=0.5
SESSION_REFRESH_MARGIN_SEC=900

# ===========================================
# Kafka/Redpanda Configuration
# ===========================================
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=trading.orders

# ===========================================
# Redis Configuration
# ===========================================
# Used to track which orders have already been synced
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # Uncomment if Redis requires authentication
REDIS_DB=0
REDIS_SYNCED_ORDERS_KEY=robinhood:synced_orders

# ===========================================
# Sync Configuration
# ===========================================
# How often to poll for new orders during market hours (in minutes)
POLL_INTERVAL_MINUTES=10

# How many days of history to sync on first run
SYNC_HISTORY_DAYS=30

# ===========================================
# Market Hours (Eastern Time)
# ===========================================
# Extended trading hours: Pre-market 4am, After-hours close 8pm
MARKET_OPEN_HOUR=4
MARKET_CLOSE_HOUR=20

# ===========================================
# Telegram Alerts (OPTIONAL)
# ===========================================
# Used to alert a human when the login retry loop halts because
# Robinhood demands an interactive device approval. Leave blank to disable.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
